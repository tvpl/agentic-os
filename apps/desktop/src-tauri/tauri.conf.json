{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MordomoOS",
  "version": "0.8.0",
  "identifier": "com.mordomo.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Local agentic OS over Claude Code, Cursor Agent and Codex",
    "copyright": "MordomoOS contributors. Functional Source License 1.1.",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../payload": "payload"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
