#!/usr/bin/env bash
# Faithful fake of the Claude Code CLI for adapter tests (stream-json shapes
# match claude 2.x headless output). Never used in production.
# FAKE_ENV_DUMP=<file>: every invocation (probes included) appends the names of its environment variables.
if [[ -n "$FAKE_ENV_DUMP" ]]; then env | cut -d= -f1 >> "$FAKE_ENV_DUMP"; fi
case "$1" in
  # FAKE_CLAUDE_VERSION=<v>: what --version reports (tested-range checks).
  --version) echo "${FAKE_CLAUDE_VERSION:-9.9.9-fake} (Claude Code)"; exit 0 ;;
  --help)
    echo "Usage: claude [options] [command] [prompt]"
    echo "  -p, --print                  print response and exit"
    echo "  --output-format <format>     text|json|stream-json"
    echo "  --model <model>              set model"
    echo "  --permission-mode <mode>     permission mode"
    echo "  --allowedTools <tools...>    allowed tools"
    echo "  --disallowedTools <tools...> disallowed tools"
    echo "  --add-dir <dirs...>          additional directories"
    echo "  -r, --resume [value]         resume a conversation by session id"
    echo "  --session-id <uuid>          use a specific session id for this conversation"
    echo "  --verbose                    verbose"
    # FAKE_CLAUDE_LOGGED_IN=1: advertise `claude auth` like the real CLI, so a machine without ~/.claude still reads as signed in.
    if [[ -n "$FAKE_CLAUDE_LOGGED_IN" ]]; then echo "  auth                         manage authentication"; fi
    exit 0 ;;
  auth)
    if [[ -n "$FAKE_CLAUDE_LOGGED_IN" && "$2" == "status" ]]; then
      echo '{"loggedIn":true,"authMethod":"fake"}'; exit 0
    fi ;;
esac

# Headless run: prompt arrives on stdin. Simulate a small stream-json session.
# The session id echoed back is the one the caller asked for (--session-id /
# --resume), like the real CLI does.
SESSION_ID="fake"
prev=""
for arg in "$@"; do
  case "$prev" in
    --session-id|--resume|-r) SESSION_ID="$arg" ;;
  esac
  prev="$arg"
done
PROMPT="$(cat)"
if [[ "$FAKE_CLAUDE_HANG" == "1" ]]; then sleep 300; exit 1; fi
# "[[env]]" in the prompt: reply with the names of the environment variables this process received.
if [[ "$PROMPT" == *"[[env]]"* ]]; then
  NAMES="$(env | cut -d= -f1 | sort | tr '\n' ' ')"
  echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"ENV: $NAMES\"}]}}"
  echo '{"type":"result","subtype":"success","is_error":false,"result":"env listed"}'
  exit 0
fi
echo "{\"type\":\"system\",\"subtype\":\"init\",\"model\":\"fake-sonnet\",\"session_id\":\"$SESSION_ID\"}"
echo '{"type":"assistant","message":{"content":[{"type":"text","text":"Working on it."}]}}'
echo '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Read","input":{"file_path":"/tmp/x"}}]}}'
# "[[unknown:TYPE]]" in the prompt prints a line of a type no CLI version emits, twice (unrecognized-line warning).
if [[ "$PROMPT" =~ \[\[unknown:([A-Za-z0-9_.-]+)\]\] ]]; then
  echo "{\"type\":\"${BASH_REMATCH[1]}\"}"
  echo "{\"type\":\"${BASH_REMATCH[1]}\"}"
fi
# "[[long]]" / "[[huge]]" in the prompt print one assistant line of 1 MiB / 5 MiB (the runner's line cap is 4 MiB) between the normal ones.
for SIZE in long:1048576 huge:5242880; do
  if [[ "$PROMPT" == *"[[${SIZE%%:*}]]"* ]]; then
    printf '{"type":"assistant","message":{"content":[{"type":"text","text":"'
    head -c "${SIZE##*:}" /dev/zero | tr '\0' 'x'
    printf '"}]}}\n'
  fi
done
# "[[wide]]" in the prompt prints one ~4 MB assistant line (just under the runner's 4 MiB cap) whose `content` is
# two million `1`s where a list of blocks belongs: a hostile wrong-shape array (a schema check per element would freeze the daemon).
if [[ "$PROMPT" == *"[[wide]]"* ]]; then
  printf '{"type":"assistant","message":{"content":['
  yes '1,' | head -n 1999999 | tr -d '\n'
  printf '1]}}\n'
fi
# "[[sleep:N]]" in the prompt keeps the run alive N seconds (e2e: approvals, squads mid-flight).
if [[ "$PROMPT" =~ \[\[sleep:([0-9]+)\]\] ]]; then sleep "${BASH_REMATCH[1]}"; fi
if [[ "$FAKE_CLAUDE_FAIL" == "1" ]]; then
  echo '{"type":"result","subtype":"error","is_error":true,"result":"boom"}'
  exit 1
fi
if [[ -n "$FAKE_CLAUDE_ARTIFACT_DIR" ]]; then
  mkdir -p "$FAKE_CLAUDE_ARTIFACT_DIR"
  echo "artifact for: ${PROMPT:0:40}" > "$FAKE_CLAUDE_ARTIFACT_DIR/digest.md"
fi
# "[[artifact:NAME]]" in the prompt writes NAME into the run's own artifacts
# directory — the one the OS names in the prompt ("… into: <dir>"), so the
# file is listed as this run's result (e2e: a result opening on the stage).
if [[ "$PROMPT" =~ \[\[artifact:([A-Za-z0-9._-]+)\]\] ]]; then
  NAME="${BASH_REMATCH[1]}"
  if [[ "$PROMPT" =~ into[^:]*:\ ([^[:space:]]+) ]]; then
    RUN_DIR="${BASH_REMATCH[1]}"
    mkdir -p "$RUN_DIR"
    printf '# %s\n\nWritten by the fake provider for: %s\n' "$NAME" "${PROMPT:0:60}" > "$RUN_DIR/$NAME"
  fi
fi
# "[[nonl-huge]]" ends the stream with a 5 MiB assistant line (over the runner's 4 MiB cap) and NO trailing newline.
if [[ "$PROMPT" == *"[[nonl-huge]]"* ]]; then
  printf '{"type":"assistant","message":{"content":[{"type":"text","text":"'
  head -c 5242880 /dev/zero | tr '\0' 'x'
  printf '"}]}}'
  exit 0
fi
# "[[nonl-unknown]]" ends the stream with a line of a type no CLI emits ("ultima") and NO trailing newline.
if [[ "$PROMPT" == *"[[nonl-unknown]]"* ]]; then
  printf '{"type":"ultima"}'
  exit 0
fi
# "[[nonl]]" in the prompt ends the stream with the result line and NO trailing newline (the cost rides on it).
if [[ "$PROMPT" == *"[[nonl]]"* ]]; then
  printf '{"type":"result","subtype":"success","is_error":false,"result":"No newline.","total_cost_usd":0.5}'
  exit 0
fi
echo '{"type":"result","subtype":"success","is_error":false,"result":"All done. secret sk-test1234567890abcdefTOKEN should be redacted."}'
exit 0
