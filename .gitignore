node_modules/
dist/
*.tsbuildinfo

# Local state (source of truth for the machine, never committed)
# Everything under the home's config/ is machine state or a secret (token, VAPID and
# signing keys, TLS key, database, backups). Anchored to the repo root so source folders
# named config/ (core/src/config, apps/command-centre/src/config) stay tracked. To version
# a file in the home's config/, add `!/config/<name>` below; nothing is versioned today.
/config/*
*.bak
logs/*.jsonl
logs/*.jsonl.*
artifacts/*
!artifacts/.gitkeep
# The default working directory of an agent run (the home itself is never one: it holds config/)
/workspace/

# Environment
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db

# Test output
tests/.tmp/
coverage/
playwright-report/

# Machine-local generated state
logs/*.log
memory/ROUTER.md
memory/areas/
memory/journal/

# Playwright
test-results/

# distributable staging and output (scripts/package.mjs)
build/
release/

# agent-skills installer backups
.agents/*.backup

# desktop shell (apps/desktop): Cargo's build output, the payload scripts/package.mjs --payload writes, Tauri's generated schemas
apps/desktop/target/
apps/desktop/payload/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/permissions/autogenerated/
